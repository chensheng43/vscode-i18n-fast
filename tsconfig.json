{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@core/*": ["core/*"],
      "@vscode-ext/*": ["vscode/*"],
      "@mcp/*": ["mcp/*"]
    }
  },
  "include": ["src/**/*"]
}
